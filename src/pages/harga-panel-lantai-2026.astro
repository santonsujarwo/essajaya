---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
const title = 'Harga Panel Lantai per M² Terbaru 2026 - essajaya';
const description =
  'Cek kisaran harga panel lantai per m² harga material & terpasang. Distributor panel lantai Mojokerto – Essa Jaya. Survey gratis, hubungi sekarang!';
const canonical = 'https://essajaya.com/harga-panel-lantai-2026/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://essajaya.com/' },
        { '@type': 'ListItem', position: 2, name: 'Harga Panel Lantai 2026', item: canonical },
      ],
    },
    { '@type': 'WebPage', name: title, url: canonical, description: description },
  ],
};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="section soft">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Beranda</a> / Harga Panel Lantai 2026
      </div>
      <div class="section-head">
        <div class="eyebrow">Harga panel lantai Mojokerto</div>
        <h1>Harga panel lantai mojokerto</h1>\n <h2>
          Harga Panel Lantai per M² Terbaru 2026 – Material &amp; Terpasang
        </h2>
        <p>
          Berikut kisaran harga panel lantai terbaru untuk material saja maupun paket terpasang.
          Harga dapat berubah sesuai ukuran panel, volume, lokasi, akses dan kondisi proyek.
        </p>
      </div>
      <div class="table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th>Produk / Paket</th>
              <th>Kisaran harga</th>
              <th>Keterangan</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Panel Lantai AAC Standar</td>
              <td>Rp 300.000–420.000 / m²</td>
              <td>Panjang sekitar 1,5–3,25 m; tebal 12,5 cm</td>
            </tr>
            <tr>
              <td>Panel Lantai AAC Premium</td>
              <td>Rp 400.000–500.000 / m²</td>
              <td>Panjang mulai sekitar 3,5 m ke atas; konfirmasi spesifikasi</td>
            </tr>
            <tr>
              <td>Paket Standar ≥48 m²</td>
              <td>Rp 440.000–550.000 / m²</td>
              <td>Material + besi angkur/pengikat + grouting + jasa pasang</td>
            </tr>
            <tr>
              <td>Paket Area Terbatas &lt;48 m²</td>
              <td>Rp 500.000–650.000 / m²</td>
              <td>Menyesuaikan luas dan mobilisasi</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="highlight">
        <strong>Catatan:</strong> harga di atas adalah kisaran yang dipublikasikan Essa Jaya. Harga final,
        ongkos kirim dan ketersediaan perlu dikonfirmasi sebelum transaksi.
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Daftar harga</div>
        <h2>Harga material panel lantai per lembar</h2>
        <p>
          Live site mencantumkan beberapa panjang panel dengan lebar 60 cm dan tebal 12,5 cm. Harga
          per lembar diberikan berdasarkan penawaran.
        </p>
      </div>
      <div class="table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th>Panjang</th>
              <th>Lebar</th>
              <th>Tebal</th>
              <th>Harga</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>147 cm</td>
              <td>60 cm</td>
              <td>12,5 cm</td>
              <td>Hubungi kami</td>
            </tr>
            <tr>
              <td>172 cm</td>
              <td>60 cm</td>
              <td>12,5 cm</td>
              <td>Hubungi kami</td>
            </tr>
            <tr>
              <td>197 cm</td>
              <td>60 cm</td>
              <td>12,5 cm</td>
              <td>Hubungi kami</td>
            </tr>
            <tr>
              <td>222 cm</td>
              <td>60 cm</td>
              <td>12,5 cm</td>
              <td>Hubungi kami</td>
            </tr>
            <tr>
              <td>247–322 cm</td>
              <td>60 cm</td>
              <td>12,5 cm</td>
              <td>Hubungi kami</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Simulasi RAB</div>
        <h2>Contoh estimasi biaya panel lantai terpasang</h2>
        <p>Simulasi menggunakan kisaran Rp 440.000–550.000/m² untuk paket terpasang.</p>
      </div>
      <div class="table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th>Skenario</th>
              <th>Luas</th>
              <th>Estimasi biaya</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Rumah tipe 36</td>
              <td>±36 m²</td>
              <td>Rp 18.000.000–23.400.000</td>
            </tr>
            <tr>
              <td>Rumah tipe 45</td>
              <td>±45 m²</td>
              <td>Rp 22.500.000–29.250.000</td>
            </tr>
            <tr>
              <td>Rumah tipe 60</td>
              <td>±60 m²</td>
              <td>Rp 26.400.000–33.000.000</td>
            </tr>
            <tr>
              <td>Rumah tipe 72</td>
              <td>±72 m²</td>
              <td>Rp 31.680.000–39.600.000</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Faktor harga</div>
        <h2>Faktor yang Mempengaruhi Harga Panel Lantai</h2>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>1. Volume atau Luas Area (m²)</h3>
          <p>Volume pekerjaan memengaruhi efisiensi material dan mobilisasi tim.</p>
        </div>
        <div class="card">
          <h3>2. Panjang Panel yang Digunakan</h3>
          <p>Panjang panel harus disesuaikan dengan bentang dan struktur bangunan.</p>
        </div>
        <div class="card">
          <h3>3. Jarak Lokasi Proyek</h3>
          <p>
            Jarak, akses kendaraan, kondisi area dan ketinggian pekerjaan dapat memengaruhi biaya.
          </p>
        </div>
      </div>
    </div>
  </section>
  <FAQ title="FAQ – Pertanyaan Seputar Harga Panel Lantai" items={[
    ['Apakah harga panel lantai sudah termasuk ongkos kirim?', 'Harga material panel lantai belum termasuk ongkos kirim. Ongkos kirim dihitung berdasarkan jarak lokasi proyek dari gudang kami di Dlanggu, Mojokerto. Untuk harga terpasang, biasanya ongkos kirim sudah termasuk dalam paket — silakan konfirmasi saat konsultasi.'],
    ['Berapa minimal order panel lantai di Essa Jaya?', 'Untuk paket terpasang, minimal order adalah 48 m². Untuk luas di bawah 48 m², tetap bisa kami layani dengan penyesuaian harga.'],
    ['Apakah ada garansi pemasangan?', 'Ya, masalah pasca pemasangan yang disebabkan kesalahan teknis tim kami akan ditangani tanpa biaya tambahan.'],
    ['Berapa lama pengerjaan pemasangan panel lantai?', 'Untuk luas 48–100 m², pengerjaan biasanya selesai dalam 1–2 hari kerja.'],
    ['Apakah bisa pesan material panel lantai saja tanpa jasa pasang?', 'Bisa. Anda dapat memesan material saja dan memperoleh arahan teknis pemasangan secara gratis.']
  ]} />
  <CTA />
</Layout>

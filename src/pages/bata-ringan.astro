---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
const faqItems = [
  [
    'Apa perbedaan bata ringan dan bata merah?',
    'Bata ringan umumnya memiliki bobot lebih rendah dan dimensi lebih presisi. Pemilihan material tetap perlu mempertimbangkan desain dinding dan kebutuhan proyek.',
  ],
  [
    'Berapa ukuran bata ringan yang tersedia?',
    'Ukuran berbeda menurut produsen dan stok. Hubungi Essa Jaya untuk memastikan dimensi, ketebalan, dan ketersediaan.',
  ],
  [
    'Berapa kebutuhan bata ringan untuk satu meter persegi?',
    'Jumlah bergantung pada ukuran bata dan ketebalan nat. Perhitungan menggunakan ukuran aktual produk serta luas bersih dinding.',
  ],
  [
    'Perekat apa yang digunakan untuk bata ringan?',
    'Pemasangan biasanya menggunakan mortar instan khusus bata ringan sesuai petunjuk produsen.',
  ],
  [
    'Apakah tersedia bata ringan KW2 atau reject palet?',
    'Pilihan kategori mengikuti stok. Kondisi fisik, toleransi ukuran, dan kecocokan penggunaan perlu diperiksa sebelum pembelian.',
  ],
  [
    'Apakah Essa Jaya melayani pengiriman?',
    'Pengiriman dikonsultasikan berdasarkan volume, alamat proyek, akses kendaraan, dan jadwal ketersediaan material.',
  ],
];
const title = 'Bata Ringan Mojokerto | Material Bangunan - Essa Jaya';
const description =
  'Bata ringan untuk kebutuhan dinding dan proyek bangunan di Mojokerto dan sekitarnya. Tersedia pilihan bata ringan standar, KW2, dan reject palet sesuai stok.';
const canonical = 'https://essajaya.com/bata-ringan/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: 'Bata Ringan',
      brand: { '@type': 'Brand', name: 'Essa Jaya' },
      url: canonical,
      description: description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://essajaya.com/' },
        { '@type': 'ListItem', position: 2, name: 'Bata Ringan', item: canonical },
      ],
    },
  ],
};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Material bangunan • Mojokerto</div>
        <h1>Bata Ringan Mojokerto</h1>
        <p>
          Essa Jaya menyediakan pilihan bata ringan untuk kebutuhan dinding dan pekerjaan bangunan.
          Stok, kondisi, ukuran, dan harga perlu dikonfirmasi sebelum pemesanan.
        </p>
        <div class="actions">
          <a
            class="btn"
            href="https://wa.me/628226440796?text=Halo%20Essa%20Jaya%2C%20saya%20ingin%20tanya%20bata%20ringan."
            >Tanya stok & harga</a
          >
          <a class="btn alt" href="/jasa-renovasi/">Jasa renovasi</a>
        </div>
      </div>
      <div class="visual">
        <div class="visual-label">
          <span class="eyebrow" style="color:#d9c8a4">Material bangunan</span>
          <strong>Bata Ringan</strong>
          <span>Pilihan material untuk pekerjaan dinding.</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Pilihan produk</div>
        <h2>Pilihan bata ringan di Essa Jaya</h2>
        <p>
          Live site mencantumkan beberapa kategori. Karena kondisi stok dapat berubah, konsultasikan
          kebutuhan dan kondisi material sebelum membeli.
        </p>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>Bata Ringan Standar</h3>
          <p>Pilihan utama untuk kebutuhan dinding. Tanyakan ukuran, stok, dan harga terkini.</p>
        </div>
        <div class="card">
          <h3>Bata Ringan KW2</h3>
          <p>
            Alternatif material yang tercantum pada katalog Essa Jaya. Kondisi dan penggunaan perlu
            dikonfirmasi.
          </p>
        </div>
        <div class="card">
          <h3>Reject Palet</h3>
          <p>
            Material reject palet hanya cocok untuk penggunaan tertentu setelah kondisi fisiknya
            diperiksa.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Pertimbangan pembelian</div>
        <h2>Pilih bata ringan berdasarkan kebutuhan proyek</h2>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Periksa kondisi material</h3>
          <p>
            Pastikan ukuran, kondisi fisik, jumlah, dan kualitas material sesuai kebutuhan sebelum
            pengiriman.
          </p>
        </div>
        <div class="card">
          <h3>Perhitungkan logistik</h3>
          <p>
            Biaya pengiriman dipengaruhi lokasi proyek, volume, dan akses kendaraan. Tim dapat
            membantu estimasi setelah lokasi diketahui.
          </p>
        </div>
      </div>
    </div>
  </section>
  <FAQ title="FAQ Bata Ringan" items={faqItems} />
  <CTA />
</Layout>

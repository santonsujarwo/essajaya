---
import Layout from '../layouts/Layout.astro';
import HowToOrder from '../components/HowToOrder.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
const faqItems = [["Apa itu panel lantai AAC?","Panel lantai AAC adalah elemen beton ringan pracetak untuk sistem lantai atau dak bangunan. Pemilihan produk harus mengikuti desain struktur dan petunjuk teknis produsen."],
["Berapa ukuran panel lantai yang tersedia?","Informasi produk Essa Jaya mencantumkan panjang sekitar 147–322 cm, lebar 60 cm, dan tebal 12,5 cm. Ketersediaan ukuran perlu dikonfirmasi sebelum pemesanan."],
["Apakah panel lantai dapat digunakan untuk rumah dua lantai?","Panel lantai dapat dipertimbangkan apabila bentang, tumpuan, beban, dan struktur pendukung direncanakan oleh tenaga yang kompeten."],
["Bagaimana menghitung kebutuhan panel lantai?","Perhitungan awal didasarkan pada luas area dan ukuran panel. Jumlah final perlu memperhitungkan pola pemasangan, detail tumpuan, potongan, dan gambar kerja."],
["Apakah Essa Jaya menyediakan jasa pemasangan?","Essa Jaya melayani konsultasi kebutuhan material dan pemasangan panel lantai. Ruang lingkup serta jadwal dibahas setelah informasi proyek diterima."],
["Apa perbedaan panel lantai dan cor beton?","Keduanya memiliki karakteristik dan persyaratan struktur berbeda. Pilihan ditentukan oleh bentang, desain, akses proyek, waktu, biaya, serta rekomendasi perencana."]];
const title='Panel Lantai Mojokerto | Panel Lantai AAC - Essa Jaya';
const description='Panel lantai AAC untuk kebutuhan dak lantai di Mojokerto dan Jawa Timur. Lihat ukuran, spesifikasi, manfaat, harga, dan konsultasikan kebutuhan proyek dengan Essa Jaya.';
const canonical='https://essajaya.com/panel-lantai/';
const schema={'@context':'https://schema.org','@graph':[{'@type':'Service','@id':canonical+'#service','name':'Panel Lantai AAC','serviceType':'Panel lantai','provider':{'@id':'https://essajaya.com/#business'},'areaServed':['Mojokerto','Sidoarjo','Surabaya','Gresik','Pasuruan','Jombang']},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Beranda','item':'https://essajaya.com/'},{'@type':'ListItem','position':2,'name':'Panel Lantai','item':canonical}]}]};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Produk utama • Mojokerto</div>
        <h1>Panel Lantai Mojokerto</h1>
        <p>Panel lantai AAC precast untuk kebutuhan dak lantai dengan proses pemasangan yang dirancang lebih cepat dibanding pengecoran konvensional. Essa Jaya melayani kebutuhan material dan konsultasi pemasangan di Mojokerto dan area sekitarnya.</p>
        <div class="actions">
          <a class="btn" href="https://wa.me/628226440796?text=Halo%20Essa%20Jaya%2C%20saya%20ingin%20konsultasi%20panel%20lantai.">Konsultasi</a>
          <a class="btn alt" href="/harga-panel-lantai-2026/">Lihat harga</a>
        </div>
      </div>
      <div class="visual">
        <div class="visual-label">
          <span class="eyebrow" style="color:#d9c8a4">Essa Jaya</span>
          <strong>Panel Lantai AAC</strong>
          <span>Material precast untuk kebutuhan dak lantai.</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Tentang produk</div>
        <h2>Panel lantai sebagai alternatif dak beton konvensional</h2>
        <p>Panel lantai merupakan elemen precast beton ringan yang diproduksi untuk digunakan pada lantai/dak bangunan. Pemilihan bentang dan tumpuan harus disesuaikan dengan kondisi struktur proyek.</p>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>Precast & presisi</h3>
          <p>Elemen diproduksi dengan ukuran yang konsisten untuk membantu perencanaan material dan pemasangan.</p>
        </div>
        <div class="card">
          <h3>Pemasangan lebih cepat</h3>
          <p>Karena elemen sudah jadi, pekerjaan tidak membutuhkan proses pengecoran lantai di tempat seperti metode konvensional.</p>
        </div>
        <div class="card">
          <h3>Material atau terpasang</h3>
          <p>Calon pelanggan dapat berkonsultasi untuk kebutuhan material saja atau paket dengan jasa pemasangan.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Data produk</div>
        <h2>Ukuran dan spesifikasi yang dipublikasikan</h2>
        <p>Data berikut mengikuti informasi live site. Spesifikasi final perlu dikonfirmasi terhadap datasheet produk dan kebutuhan struktur proyek.</p>
      </div>
      <div class="specs">
        <div class="spec">
          <span>Panjang</span>
          <b>147–322 cm</b>
        </div>
        <div class="spec">
          <span>Lebar</span>
          <b>60 cm</b>
        </div>
        <div class="spec">
          <span>Tebal</span>
          <b>12,5 cm</b>
        </div>
        <div class="spec">
          <span>Berat jenis kering</span>
          <b>650 kg/m³</b>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Karakteristik panel AAC</div>
        <h2>Informasi tambahan produk panel lantai AAC</h2>
        <p>Panel AAC merupakan elemen pracetak yang dipasang pada struktur tumpuan sesuai perhitungan teknis. Penggunaan sistem ini dapat mengurangi pekerjaan pengecoran di tempat dan kebutuhan bekisting dibanding metode cor konvensional. Detail pemasangan tetap mengikuti panduan produsen dan perencana struktur.</p>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>Elemen pracetak</h3>
          <p>Panel diproduksi terlebih dahulu sehingga pekerjaan di lokasi berfokus pada penanganan dan pemasangan.</p>
        </div>
        <div class="card">
          <h3>Perencanaan bentang</h3>
          <p>Ukuran panjang panel dipilih berdasarkan bentang, tumpuan, beban, dan desain struktur.</p>
        </div>
        <div class="card">
          <h3>Periksa datasheet</h3>
          <p>Pastikan kapasitas, detail sambungan, dan metode pemasangan mengacu pada dokumen teknis produk.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Harga & pembelian</div>
        <h2>Butuh harga panel lantai terbaru?</h2>
        <p>Halaman harga mempertahankan permalink existing yang sudah digunakan website.</p>
      </div>
      <a class="card" href="/harga-panel-lantai-2026/">
        <h3>Harga Panel Lantai per M² Terbaru 2026 →</h3>
        <p>Lihat kisaran harga material, paket terpasang, simulasi RAB, dan faktor biaya.</p>
      </a>
    </div>
  </section>
  <HowToOrder />
  <FAQ title="FAQ Panel Lantai" items={faqItems} />
  <CTA />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import CaraOrder from '../components/CaraOrder.astro';
import CTA from '../components/CTA.astro';
const title = 'Jasa Pasang Panel Lantai Mojokerto | Essa Jaya';
const description =
  'Jasa pemasangan panel lantai di Mojokerto dan Jawa Timur. Survey lokasi, pengukuran, koordinasi struktur balok, material, grouting dan pemasangan.';
---

<Layout {title} {description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Jasa pemasangan</div>
        <h1>Jasa Pasang Panel Lantai Mojokerto</h1>
        <p>
          Mulai dari konsultasi dan survey lokasi hingga pemasangan panel lantai. Essa Jaya membantu
          menyiapkan estimasi kebutuhan dan penawaran berdasarkan kondisi proyek.
        </p>
        <div class="actions">
          <a
            class="btn"
            href="https://wa.me/628226440796?text=Halo%20Essa%20Jaya%2C%20saya%20ingin%20survey%20dan%20jasa%20pasang%20panel%20lantai."
            >Minta survey</a
          >
          <a class="btn alt" href="/harga-panel-lantai-2026/">Cek kisaran harga</a>
        </div>
      </div>
      <div class="visual">
        <div class="visual-label">
          <strong>Survey → Pasang</strong>
          <span
            >Alur kerja dibuat sederhana agar kebutuhan proyek dapat dikonfirmasi sebelum
            pemasangan.</span
          >
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Alur kerja</div>
        <h2>Dari lokasi sampai pemasangan</h2>
      </div>
      <div class="grid-3">
        <div class="card">
          <div class="number">01</div>
          <h3>Konsultasi</h3>
          <p>Sampaikan luas dak, lokasi, jenis bangunan, dan jadwal proyek.</p>
        </div>
        <div class="card">
          <div class="number">02</div>
          <h3>Survey & pengukuran</h3>
          <p>
            Tim datang ke lokasi untuk mengukur area dan berkoordinasi mengenai kebutuhan
            balok/tumpuan.
          </p>
        </div>
        <div class="card">
          <div class="number">03</div>
          <h3>Penawaran</h3>
          <p>
            Estimasi material, jasa, mobilisasi, dan komponen pekerjaan dibahas sebelum kesepakatan.
          </p>
        </div>
        <div class="card">
          <div class="number">04</div>
          <h3>Persiapan material</h3>
          <p>
            Material panel, komponen pengikat, dan kebutuhan grouting dipersiapkan sesuai
            kesepakatan.
          </p>
        </div>
        <div class="card">
          <div class="number">05</div>
          <h3>Pemasangan</h3>
          <p>
            Panel dipasang pada tumpuan yang telah disiapkan kemudian pekerjaan sambungan dan
            grouting diselesaikan.
          </p>
        </div>
        <div class="card">
          <div class="number">06</div>
          <h3>Serah terima</h3>
          <p>Pekerjaan diperiksa bersama sesuai ruang lingkup yang tercantum dalam kesepakatan.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Yang perlu disiapkan</div>
        <h2>Informasi proyek yang membantu kami memberi estimasi</h2>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Luas area</h3>
          <p>Perkiraan luas lantai dalam m² dan bentuk denah bila tersedia.</p>
        </div>
        <div class="card">
          <h3>Lokasi</h3>
          <p>Alamat atau area proyek untuk menghitung akses dan mobilisasi.</p>
        </div>
        <div class="card">
          <h3>Kondisi struktur</h3>
          <p>Informasi balok/tumpuan yang sudah tersedia dan kondisi bangunan.</p>
        </div>
        <div class="card">
          <h3>Target waktu</h3>
          <p>Kapan material dibutuhkan dan kapan pekerjaan ingin dimulai.</p>
        </div>
      </div>
    </div>
  </section>
  <CaraOrder />
  <CTA />
</Layout>

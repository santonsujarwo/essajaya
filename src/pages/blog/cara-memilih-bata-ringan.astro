---
import Layout from '../../layouts/Layout.astro';
import HowToOrder from '../../components/HowToOrder.astro';
import CTA from '../../components/CTA.astro';
const title = 'Cara Memilih Bata Ringan untuk Proyek Bangunan | Essa Jaya';
const description =
  'Pertimbangan ukuran, kondisi material, volume, logistik dan kebutuhan dinding.';
const canonical = 'https://essajaya.com/blog/cara-memilih-bata-ringan/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  author: { '@type': 'Organization', name: 'Essa Jaya' },
  publisher: { '@type': 'Organization', name: 'Essa Jaya', url: 'https://essajaya.com/' },
};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="section soft">
    <div class="container article">
      <div class="breadcrumb">
        <a href="/">Beranda</a> / <a href="/blog/">Blog</a> / Cara Memilih Bata Ringan untuk Proyek Bangunan
      </div>
      <div class="eyebrow">Panduan Essa Jaya</div>
      <h1>Cara Memilih Bata Ringan untuk Proyek Bangunan</h1>
      <p>Pertimbangan ukuran, kondisi material, volume, logistik dan kebutuhan dinding.</p>
      <h2>Ringkasan</h2>
      <p>
        Artikel ini membantu calon pelanggan memahami faktor yang perlu dipertimbangkan sebelum
        menentukan material atau pekerjaan. Informasi teknis dan harga dapat berbeda berdasarkan
        produk, kondisi bangunan, lokasi, dan spesifikasi proyek.
      </p>
      <h2>Hal yang perlu diperhatikan</h2>
      <ul>
        <li>Pastikan kebutuhan dan ukuran area dihitung terlebih dahulu.</li>
        <li>Konfirmasi spesifikasi material terhadap produk yang benar-benar tersedia.</li>
        <li>Pertimbangkan akses lokasi, pengiriman, tenaga kerja dan kondisi struktur.</li>
        <li>Gunakan survey dan penawaran untuk menentukan kebutuhan akhir proyek.</li>
      </ul>
      <h2>Kapan perlu berkonsultasi?</h2>
      <p>
        Jika proyek membutuhkan perhitungan material, pemasangan atau renovasi, sampaikan lokasi,
        ukuran/volume, kondisi bangunan dan target pekerjaan kepada Essa Jaya agar tim dapat
        menentukan informasi yang relevan.
      </p>
      <p>
        <a class="btn" href="https://wa.me/628226440796">Konsultasikan proyek</a>
      </p>
    </div>
  </section>
  <HowToOrder />
  <CTA />
</Layout>

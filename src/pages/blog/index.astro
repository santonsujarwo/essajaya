---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/blog.js';

const title = 'Blog Material Bangunan & Renovasi | Essa Jaya';
const description =
  'Artikel dan panduan Essa Jaya seputar panel lantai, bata ringan, konstruksi, dan renovasi rumah.';
const canonical = 'https://essajaya.com/blog/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonical,
  description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://essajaya.com/blog/${post.slug}/`,
      name: post.title,
    })),
  },
};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Blog Essa Jaya</div>
        <h1>Artikel &amp; Panduan</h1>
        <p>
          Temukan informasi dan panduan seputar panel lantai, bata ringan, konstruksi, serta
          perencanaan renovasi rumah untuk membantu Anda menyiapkan proyek.
        </p>
      </div>
      <div class="visual">
        <div class="visual-label">
          <span class="eyebrow" style="color:#d9c8a4">Knowledge hub</span>
          <strong>Material &amp; Renovasi</strong>
          <span>Informasi untuk kebutuhan proyek bangunan.</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-3">
        {
          posts.map((post) => (
            <article class="card blog-card">
              <a href={`/blog/${post.slug}/`}>
                <img class="blog-thumb" src={post.image} alt={post.imageAlt} loading="lazy" />
                <div class="eyebrow">Panduan</div>
                <h2 style="font-size:1.35rem;margin:10px 24px">{post.title}</h2>
              </a>
              <p>{post.description}</p>
              <a class="btn alt" href={`/blog/${post.slug}/`}>
                Baca artikel
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
const title = 'Proyek Panel Lantai | Essa Jaya Mojokerto';
const description =
'Dokumentasi dan contoh pekerjaan panel lantai Essa Jaya. Halaman proyek digunakan untuk melihat area layanan, proses pemasangan, dan informasi pekerjaan.';
---

<Layout {title} {description}>
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Dokumentasi pekerjaan</div>
      <h1>Proyek Panel Lantai</h1>
      <p>
        Halaman ini menjadi pusat dokumentasi proyek Essa Jaya. Tambahkan foto
        sebelum, proses, dan setelah pemasangan untuk memperkuat bukti pengalaman
        serta membantu calon pelanggan memahami pekerjaan.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-3">
        <article class="card">
          <div class="eyebrow">Mojokerto</div>
          <h3>Proyek panel lantai rumah</h3>
          <p>
            Dokumentasikan luas area, ukuran panel, kondisi balok, durasi
            pemasangan, dan foto hasil pekerjaan.
          </p>
        </article>
        <article class="card">
          <div class="eyebrow">Sidoarjo</div>
          <h3>Proyek panel lantai</h3>
          <p>
            Gunakan halaman proyek untuk memperlihatkan kondisi lokasi dan solusi
            yang digunakan.
          </p>
        </article>
        <article class="card">
          <div class="eyebrow">Surabaya</div>
          <h3>Proyek panel lantai</h3>
          <p>
            Tambahkan detail akses, mobilisasi, dan hasil pekerjaan sebagai bukti
            pengalaman lokal.
          </p>
        </article>
      </div>
    </div>
  </section>
  <CTA />
</Layout>

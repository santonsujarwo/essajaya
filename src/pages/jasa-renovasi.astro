---
import Layout from '../layouts/Layout.astro';
import CaraOrder from '../components/CaraOrder.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';

const faqItems = [
  [
    'Pekerjaan renovasi apa saja yang dapat dikonsultasikan?',
    'Essa Jaya menerima konsultasi bangun rumah, desain rumah, partisi dan plafon, pengecatan, konstruksi baja, serta pekerjaan sipil sesuai ruang lingkup proyek.',
  ],
  [
    'Apakah Essa Jaya melayani survey lokasi?',
    'Survey dapat dibahas untuk memahami kondisi bangunan, akses lokasi, ukuran pekerjaan, dan kebutuhan material.',
  ],
  [
    'Bagaimana mendapatkan estimasi biaya renovasi?',
    'Kirimkan alamat proyek, foto kondisi bangunan, kebutuhan pekerjaan, ukuran area, dan target waktu. Estimasi disesuaikan setelah ruang lingkup jelas.',
  ],
  [
    'Apakah biaya sudah termasuk material dan tenaga kerja?',
    'Komponen biaya dijelaskan dalam penawaran. Pastikan rincian material, tenaga kerja, pekerjaan tambahan, pengiriman, dan pengecualian tertulis.',
  ],
  [
    'Berapa lama proses renovasi rumah?',
    'Durasi bergantung pada luas, kondisi bangunan, kompleksitas, ketersediaan material, cuaca, dan perubahan pekerjaan.',
  ],
  [
    'Bagaimana proses pemesanan jasa renovasi?',
    'Mulai dari konsultasi, survey lokasi, penyusunan ruang lingkup dan penawaran, persetujuan, lalu penjadwalan pekerjaan.',
  ],
];
const title = 'Jasa Renovasi Rumah Mojokerto - essajaya';
const description =
  'Jasa renovasi rumah Mojokerto untuk perbaikan atap, kamar mandi, perluasan bangunan, desain rumah, plafon, pengecatan, konstruksi baja dan pekerjaan sipil. Konsultasikan proyek dengan Essa Jaya.';
const canonical = 'https://essajaya.com/jasa-renovasi/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': canonical + '#service',
      name: 'Jasa Renovasi Rumah Mojokerto',
      serviceType: 'Renovasi rumah dan pekerjaan konstruksi',
      provider: { '@id': 'https://essajaya.com/#business' },
      areaServed: ['Mojokerto', 'Sidoarjo', 'Surabaya', 'Gresik', 'Pasuruan', 'Jombang'],
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://essajaya.com/' },
        { '@type': 'ListItem', position: 2, name: 'Jasa Renovasi Rumah', item: canonical },
      ],
    },
  ],
};
---

<Layout {title} {description} {canonical} {schema}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Jasa konstruksi • Mojokerto</div>
        <h1>Jasa Renovasi Rumah Mojokerto</h1>
        <p>
          Essa Jaya melayani renovasi rumah dan pekerjaan konstruksi di Mojokerto. Layanan mencakup
          perbaikan atap dan kamar mandi, pengecatan, perluasan bangunan, serta pekerjaan lain sesuai
          kebutuhan dan kondisi lokasi proyek.
        </p>
        <div class="actions">
          <a
            class="btn"
            href="https://wa.me/6282264460796?text=Halo%20Essa%20Jaya%2C%20saya%20ingin%20konsultasi%20jasa%20renovasi."
            >Konsultasi renovasi</a
          >
          <a class="btn alt" href="/hubungi-kami/">Informasi layanan</a>
        </div>
      </div>
      <div class="visual">
        <div class="visual-label">
          <span class="eyebrow" style="color:#d9c8a4">Essa Jaya</span>
          <strong>Renovasi Rumah</strong>
          <span>Perencanaan ruang lingkup, material, dan pekerjaan sesuai proyek.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Layanan</div>
        <h2>Layanan renovasi dan konstruksi rumah</h2>
        <p>
          Konsultasikan kebutuhan pekerjaan, mulai dari pembangunan hingga perbaikan bagian rumah.
          Ruang lingkup dan estimasi dibahas berdasarkan kondisi proyek.
        </p>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>Bangun Rumah</h3>
          <p>Pekerjaan pembangunan rumah berdasarkan kebutuhan ruang, kondisi lahan, dan perencanaan proyek.</p>
        </div>
        <div class="card">
          <h3>Desain Rumah</h3>
          <p>Konsultasi kebutuhan desain dan penataan ruang sebelum pekerjaan pembangunan atau renovasi.</p>
        </div>
        <div class="card">
          <h3>Partisi & Plafon</h3>
          <p>Pekerjaan plafon dan partisi untuk penataan serta pembagian ruang.</p>
        </div>
        <div class="card">
          <h3>Pengecatan</h3>
          <p>Pengecatan dan penyegaran permukaan sesuai kondisi serta spesifikasi proyek.</p>
        </div>
        <div class="card">
          <h3>Konstruksi Baja</h3>
          <p>Pekerjaan struktur atau elemen baja sesuai kebutuhan proyek dan hasil survey.</p>
        </div>
        <div class="card">
          <h3>Konstruksi Sipil</h3>
          <p>Pekerjaan konstruksi sipil disesuaikan dengan ruang lingkup dan kondisi lapangan.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Komitmen layanan</div>
        <h2>Perencanaan dan komunikasi pekerjaan yang jelas</h2>
        <p>
          Sebelum pekerjaan dimulai, kebutuhan proyek, ruang lingkup, pilihan material, estimasi biaya,
          dan jadwal dibahas bersama. Survey membantu memahami kondisi bangunan dan akses lokasi agar
          penawaran lebih sesuai dengan pekerjaan yang diperlukan.
        </p>
      </div>
      <div class="grid-3">
        <div class="card">
          <h3>Tim berpengalaman</h3>
          <p>Pekerjaan dibahas berdasarkan kebutuhan dan kondisi proyek.</p>
        </div>
        <div class="card">
          <h3>Pilihan material</h3>
          <p>Material disesuaikan dengan fungsi dan spesifikasi pekerjaan.</p>
        </div>
        <div class="card">
          <h3>Penawaran transparan</h3>
          <p>Ruang lingkup dan komponen biaya dijelaskan sebelum pekerjaan disepakati.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Lokasi layanan</div>
        <h2>Konsultasi renovasi rumah di Mojokerto</h2>
        <p>
          Essa Jaya berlokasi di Dsn. Lengkong RT 05/RW 02, Desa Kedunglengkong, Kecamatan Dlanggu,
          Mojokerto, Jawa Timur 61371. Hubungi tim kami untuk membahas lokasi dan kebutuhan pekerjaan.
        </p>
      </div>
    </div>
  </section>

  <CaraOrder />
  <FAQ title="FAQ Jasa Renovasi" items={faqItems} />
  <CTA />
</Layout>

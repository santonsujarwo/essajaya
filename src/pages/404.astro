---
import Layout from '../layouts/Layout.astro';
const title = 'Halaman Tidak Ditemukan | Essa Jaya';
const description =
  'Halaman yang Anda cari tidak ditemukan. Kembali ke Essa Jaya untuk melihat panel lantai, bata ringan, dan jasa renovasi.';
const canonical = 'https://essajaya.com/404/';
---

<Layout {title} {description} {canonical}>
  <section class="section">
    <div class="container" style="text-align:center">
      <div class="eyebrow">404</div>
      <h1>Halaman tidak ditemukan</h1>
      <p>Silakan kembali ke beranda atau pilih layanan yang Anda butuhkan.</p>
      <div class="actions" style="justify-content:center">
        <a class="btn" href="/">Kembali ke beranda</a>
      </div>
    </div>
  </section>
</Layout>

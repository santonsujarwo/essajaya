---
const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Panel lantai', href: '/panel-lantai/' },
  { label: 'Bata ringan', href: '/bata-ringan/' },
  { label: 'Renovasi', href: '/jasa-renovasi/' },
  { label: 'Artikel', href: '/blog/' },
];
---
<header class="nav">
  <div class="container navin">
    <a class="logo" href="/" aria-label="Essa Jaya Beranda"><span class="logo-mark">EJ</span><span>ESSA JAYA</span></a>
    <button class="menu-toggle" aria-label="Buka navigasi" aria-expanded="false">☰</button>
    <nav class="links" aria-label="Navigasi utama">
      {navItems.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
      <a class="nav-cta" href="/hubungi-kami/">Hubungi kami</a>
    </nav>
  </div>
</header>
<script>
const toggle = document.querySelector('.menu-toggle');
const links = document.querySelector('.links');
toggle?.addEventListener('click', () => {
  const opened = links?.classList.toggle('open') ?? false;
  toggle.setAttribute('aria-expanded', String(opened));
  toggle.textContent = opened ? '×' : '☰';
});
</script>
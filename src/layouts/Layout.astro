---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
const { title, description, canonical, image='/og-image.svg', schema=null } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://essajaya.com').toString();

---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Essa Jaya" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={`https://essajaya.com${image}`} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#c52826" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <slot name="head" />{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <style is:global>
  :root{--red:#c52826;--ink:#111318;--muted:#626970;--line:#dedede;--soft:#f3f3f3;--white:#fff;--max:1180px;font-family:'Stack Sans Headline',Arial,sans-serif;color:var(--ink);font-size:16px}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);line-height:1.55}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.container{width:min(var(--max),calc(100% - 48px));margin:auto}
  h1,h2,h3{margin:0;font-weight:500;line-height:1.2;letter-spacing:-.035em}h1{font-size:clamp(36px,4.2vw,64px);line-height:1.12;letter-spacing:-.045em}h2{font-size:clamp(28px,2.5vw,38px)}h3{font-size:24px}p{margin:0 0 18px;color:var(--muted)}
  .eyebrow{font-size:13px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:var(--red)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 24px;background:var(--red);color:white;font-size:15px;font-weight:600;border:1px solid var(--red);border-radius:0;transition:.2s}.btn:hover{background:#a91f1e;border-color:#a91f1e;transform:translateY(-1px)}.btn.alt{background:transparent;color:var(--ink);border-color:var(--ink)}.btn.light{background:#fff;color:var(--ink);border-color:#fff}
  .nav{position:relative;z-index:50;background:#fff;border-bottom:1px solid var(--line)}.navin{min-height:140px;display:flex;align-items:center;justify-content:space-between;gap:30px}.brand-logo img{width:100px;height:100px;object-fit:contain}.links{display:flex;align-items:center;gap:60px;font-size:16px;color:#111;white-space:nowrap}.links a:hover,.links a[aria-current=page]{color:var(--red)}.menu-toggle{display:none;border:0;background:transparent;font-size:26px;color:var(--ink)}
  .hero{padding:50px 0 100px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:560px 1fr;gap:80px;align-items:center}.hero-grid>div:first-child{display:flex;flex-direction:column;align-items:flex-start;gap:14px}.hero p{font-size:18px;line-height:1.6;color:#25292d;max-width:600px}.hero .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:4px}.visual{min-height:400px;position:relative;overflow:hidden;background:linear-gradient(145deg,#b8d7ec,#e7eef0 52%,#9eabb0);border:1px solid #111}.visual:before{content:'';position:absolute;left:10%;right:8%;bottom:12%;height:65%;background:linear-gradient(110deg,#f8f8f4 0 58%,#cfd8dc 58%);clip-path:polygon(0 22%,52% 0,100% 21%,100% 100%,0 100%);filter:drop-shadow(0 12px 10px #53636a55)}.visual:after{content:'';position:absolute;left:0;right:0;bottom:0;height:13%;background:linear-gradient(170deg,#b4b7a8,#748274)}.visual-label{position:absolute;z-index:2;left:24px;bottom:24px;color:#fff;text-shadow:0 1px 4px #333}.visual-label strong{display:block;font-size:23px}
  .section{padding:100px 0;border-bottom:1px solid var(--line)}.section.soft{background:var(--soft)}.section.dark{background:#17191d;color:#fff}.section.dark h2,.section.dark h3{color:#fff}.section.dark p{color:#d1d3d6}.section-head,.section-intro{max-width:760px;margin-bottom:48px}.section-head p,.section-intro p{font-size:18px;max-width:580px}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}.card{background:#fff;border:1px solid var(--line);border-radius:0;padding:28px;box-shadow:none}.soft .card{background:#fff}.card h3{margin-bottom:12px}.card p{font-size:15px;line-height:1.65}.number{width:38px;height:38px;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:700;margin-bottom:20px}.specs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.spec{padding:20px;border:1px solid var(--line);background:#fff}.spec b{display:block;color:var(--ink);font-size:1.05rem}.table-wrap{overflow:auto;border:1px solid var(--line)}.price-table{width:100%;border-collapse:collapse;min-width:700px;background:#fff}.price-table th,.price-table td{padding:15px 18px;text-align:left;border-bottom:1px solid var(--line)}.price-table th{background:#24272b;color:#fff}.faq{border-top:1px solid var(--line)}details{padding:20px 0;border-bottom:1px solid var(--line)}summary{cursor:pointer;font-weight:700;color:var(--ink)}.cta{padding:72px 0;background:#24272b;color:#fff}.cta h2{color:#fff}.cta p{color:#d4d6d8}.cta .container{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap}
  .footer{background:#fff;color:#555;padding:65px 0 25px;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1.2fr .8fr .9fr;gap:55px}.footer h3,.footer h4{color:#111;margin:0 0 15px}.footer h3{font-size:24px}.footer p,.footer a{font-size:14px;color:#555}.footer a:hover{color:var(--red)}.footer .logo{color:#111}.legal{border-top:1px solid var(--line);margin-top:35px;padding-top:20px;font-size:12px;color:#777;display:flex;justify-content:space-between;gap:20px}.socials{display:flex;flex-wrap:wrap;gap:12px}.map-wrap{margin-top:35px;border:1px solid var(--line)}.map-wrap iframe{display:block;width:100%;height:260px;border:0}.map-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.breadcrumb{padding:18px 0;font-size:13px;color:var(--muted)}.article{max-width:860px}.article h2{margin-top:42px}.article h3{margin-top:28px}.article ul,.article ol{color:var(--muted);padding-left:22px}.highlight{padding:24px;border-left:4px solid var(--red);background:var(--soft);margin:25px 0}.location-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.location{padding:18px;border:1px solid var(--line);font-weight:700;color:var(--ink);background:#fff}.product-card{display:flex;flex-direction:column;justify-content:space-between;min-height:220px}.product-card .btn{align-self:flex-start}.steps{counter-reset:step}.step{position:relative;padding-left:62px}.step:before{counter-increment:step;content:counter(step);position:absolute;left:0;top:0;width:40px;height:40px;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:700}.muted-note{font-size:13px;color:var(--muted)}.social-proof{background:var(--soft);border-bottom:1px solid var(--line)}.social-proof{background:#f3f3f3;border-bottom:1px solid #d9d9d9}.social-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;padding:50px 0}.social-item{display:flex;flex-direction:column;align-items:flex-start;gap:10px}.social-icon{width:42px;height:42px;object-fit:contain}.social-name{font-size:18px;color:#111}.social-value{font-size:24px;line-height:1.25;font-weight:600;color:#111}.stars{color:#f59e0b;font-size:13px;letter-spacing:2px}.products .product-card{min-height:320px;display:flex;flex-direction:column;justify-content:space-between}.product-icon{width:70px;height:64px;color:var(--red);margin-bottom:25px}.product-icon svg{width:64px;height:64px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.text-link{display:inline-flex;gap:10px;align-items:center;color:var(--red);font-weight:700;font-size:15px;margin-top:18px}.about-grid{display:grid;grid-template-columns:520px 1fr;gap:60px;align-items:center}.about-image{height:420px;background:linear-gradient(145deg,#c7dce8,#e9eeee 50%,#9eabb0);position:relative;overflow:hidden}.about-image:after{content:'';position:absolute;inset:25% 10% 10%;background:linear-gradient(110deg,#f8f8f4 0 58%,#cfd8dc 58%);clip-path:polygon(0 22%,52% 0,100% 21%,100% 100%,0 100%)}.order-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;align-items:center}.order-step{display:grid;grid-template-columns:64px 1fr;gap:22px;align-items:start;margin-bottom:14px}.order-number{width:64px;height:64px;background:var(--red);color:#fff;display:grid;place-items:center;font-size:22px;font-weight:700}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.blog-thumb{height:190px;background:#ddd}.sticky-actions{position:fixed;z-index:100;bottom:12px;left:50%;transform:translateX(-50%);width:min(calc(100% - 24px),520px);display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:7px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 28px #0002}.sticky-btn{height:46px;display:flex;align-items:center;justify-content:center;gap:8px;color:#fff;font-size:14px;font-weight:700}.sticky-contact{background:var(--red)}.sticky-directions{background:#292c30}
  @media(max-width:1050px){.hero-grid{grid-template-columns:1fr 1fr;gap:38px}.links{gap:14px;font-size:13px}.navin{min-height:90px}.about-grid{grid-template-columns:1fr 1fr;gap:35px}}
  @media(max-width:820px){.menu-toggle{display:block}.links{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);padding:20px 24px 25px;flex-direction:column;align-items:flex-start;gap:17px}.links.open{display:flex}.navin{min-height:76px}.hero-grid,.about-grid,.order-grid,.grid-2,.footer-grid{grid-template-columns:1fr}.hero-grid{gap:35px}.visual{min-height:320px}.about-image{height:320px}.grid-3{grid-template-columns:1fr 1fr}.section{padding:72px 0}.specs{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.container{width:calc(100% - 32px)}.hero{padding:40px 0 55px}.hero h1{font-size:39px}.hero p{font-size:16px}.visual{min-height:270px}.grid-3,.location-grid,.blog-grid{grid-template-columns:1fr}.social-grid{grid-template-columns:1fr 1fr;gap:25px 15px;padding:30px 0}.social-value{font-size:17px}.section{padding:65px 0}.section-head,.section-intro{margin-bottom:30px}.section-head p,.section-intro p{font-size:16px}.products .product-card{min-height:270px}.order-step{grid-template-columns:48px 1fr;gap:15px}.order-number{width:48px;height:48px}.footer-grid{gap:30px}.legal{flex-direction:column}.sticky-actions{bottom:7px;width:calc(100% - 14px)}}
  
.blog-card{overflow:hidden;padding:0 0 24px}.blog-thumb{display:block;width:100%;height:210px;object-fit:cover;background:#e5e5e5}.blog-card h2,.blog-card h3{margin:12px 24px}.blog-card p,.blog-card .eyebrow,.blog-card .btn{margin-left:24px;margin-right:24px}.blog-card>a:first-child{display:block;margin:0}

  .site-footer{background:#fff;border-top:1px solid #d9d9d9;border-bottom:10px solid #d9d9d9;padding:100px 0 50px}
  .footer-layout{display:grid;grid-template-columns:372px minmax(0,772px);justify-content:space-between;gap:34px}
  .footer-brand h2{font-size:40px;font-weight:700;letter-spacing:-.03em;color:#111}
  .footer-content{display:flex;flex-direction:column;gap:30px}
  .footer-description{font-size:20px;line-height:30px;color:#111;margin:0}
  .footer-contact-row{display:flex;align-items:center;gap:30px;flex-wrap:wrap}
  .footer-socials{display:flex;align-items:center;gap:20px}
  .social-circle{width:55px;height:55px;border-radius:50%;display:grid;place-items:center;overflow:hidden}
  .social-circle img{width:28px;height:28px;object-fit:contain}
  .social-circle.facebook{background:#1356a4}.social-circle.instagram{background:#c59826}
  .social-circle.instagram svg{width:28px;height:28px;fill:none;stroke:#fff;stroke-width:2}
  .social-circle.youtube{background:#c52626}.social-circle.tiktok{background:#080808}
  .footer-whatsapp{height:55px;padding:0 20px;border-radius:100px;background:#26c579;color:#fff;display:flex;align-items:center;gap:10px;font-size:20px;white-space:nowrap}
  .footer-whatsapp svg{width:28px;height:28px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .footer-details{display:grid;grid-template-columns:164px 218px;gap:100px;min-height:192px}
  .footer-details h3{font-size:20px;line-height:30px;font-weight:400;margin:0 0 10px;color:#111}
  .footer-details ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .footer-details li a,.footer-details p{font-size:16px;line-height:24px;color:#111;margin:0}
  .footer-details li a:before{content:'›';font-size:18px;margin-right:8px}
  .directions-link{display:inline-flex;gap:10px;margin-top:10px;color:#c52826;font-size:16px;font-weight:700}
  .footer-legal{border-top:1px solid #d9d9d9;padding-top:20px;margin-top:30px;font-size:14px;color:#666}
  @media(max-width:1100px){.links{gap:28px}.footer-layout{grid-template-columns:260px 1fr}.footer-details{gap:45px}}
  @media(max-width:820px){.navin{min-height:100px}.links{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);padding:20px 24px 25px;flex-direction:column;align-items:flex-start;gap:17px}.links.open{display:flex}.menu-toggle{display:block}.brand-logo img{width:80px;height:80px}.footer-layout{grid-template-columns:1fr;gap:28px}.footer-details{gap:35px}.footer-description{font-size:18px}}
  @media(max-width:560px){.social-grid{grid-template-columns:1fr 1fr;gap:28px 16px;padding:32px 0}.social-name{font-size:16px}.social-value{font-size:20px}.footer-details{grid-template-columns:1fr 1fr;gap:22px}.footer-contact-row{gap:18px}.footer-socials{gap:12px}.social-circle{width:48px;height:48px}.footer-whatsapp{font-size:16px;height:48px}.footer-brand h2{font-size:34px}.site-footer{padding:65px 0 35px}}

</style>
</head>
<body>
  <Header />
  <main><slot /></main><Footer />
  <div class="sticky-actions" aria-label="Aksi cepat"><a class="sticky-btn sticky-contact" href="https://wa.me/628226440796">↗ Hubungi kami</a><a class="sticky-btn sticky-directions" href="https://www.google.com/maps/search/?api=1&query=Essa+Jaya+Dsn+Lengkong+Dlanggu+Mojokerto" target="_blank" rel="noopener">⌖ Petunjuk arah</a></div>
  
</body></html>
